{
  "name": "studyflow",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts && node scripts/prepare-site.mjs",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1 --port 4173",
    "test": "vitest run --config frontend/vite.config.ts",
    "test:watch": "vitest --config frontend/vite.config.ts",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css,html,json}\" \"scripts/*.mjs\" package.json .github/workflows/pages.yml README.md",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css,html,json}\" \"scripts/*.mjs\" package.json .github/workflows/pages.yml README.md"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
